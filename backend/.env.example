# Copy to backend/.env and fill in. NEVER commit .env or put the key in the APK / web bundle.
# Provider: gemini | openai | deepseek | mock   (mock = offline fixture, results are labelled "không phải AI")
AI_PROVIDER=gemini
AI_API_KEY=
# Optional overrides (empty = preset):
#   gemini  -> https://generativelanguage.googleapis.com/v1beta/openai , gemini-3.5-flash (2.5-flash is closed to new users)
#   openai  -> https://api.openai.com/v1 , gpt-5.4-mini
#   deepseek-> https://api.deepseek.com , deepseek-chat  (check that the model accepts images)
AI_BASE_URL=
AI_MODEL=
AI_FALLBACK_MODEL=gemini-flash-lite-latest
AI_REASONING_EFFORT=low
AI_TIMEOUT_S=45
JOB_DEADLINE_S=90
MAX_UPLOAD_MB=5
CORS_ORIGINS=*
# Fonts with Vietnamese diacritics (auto-detects Noto Sans / Roboto / Arial if empty)
FONT_BOLD=
FONT_REGULAR=
